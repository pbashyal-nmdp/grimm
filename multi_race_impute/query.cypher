MATCH (abr)-[c1]-(abcr:`ABCR`)-[c2]-(abcqr:`ABCQR`)
  WHERE abr.name IN [ 'A*02:01~B*13:02~DRB1*01:01', 'A*02:01~B*13:02~DRB1*01:02', 'A*02:01~B*13:02~DRB1*01:03',
    'A*02:02~B*13:02~DRB1*01:01', 'A*02:02~B*13:02~DRB1*01:02', 'A*02:02~B*13:02~DRB1*01:03',
    'A*02:05~B*13:02~DRB1*01:01', 'A*02:05~B*13:02~DRB1*01:02', 'A*02:05~B*13:02~DRB1*01:03',
    'A*02:06~B*13:02~DRB1*01:01', 'A*02:06~B*13:02~DRB1*01:02', 'A*02:06~B*13:02~DRB1*01:03',
    'A*02:13~B*13:02~DRB1*01:01', 'A*02:13~B*13:02~DRB1*01:02', 'A*02:13~B*13:02~DRB1*01:03',
    'A*02:17~B*13:02~DRB1*01:01', 'A*02:17~B*13:02~DRB1*01:02', 'A*02:17~B*13:02~DRB1*01:03',
    'A*02:19~B*13:02~DRB1*01:01', 'A*02:19~B*13:02~DRB1*01:02', 'A*02:19~B*13:02~DRB1*01:03',
    'A*02:20~B*13:02~DRB1*01:01', 'A*02:20~B*13:02~DRB1*01:02', 'A*02:20~B*13:02~DRB1*01:03',
    'A*02:24~B*13:02~DRB1*01:01', 'A*02:24~B*13:02~DRB1*01:02', 'A*02:24~B*13:02~DRB1*01:03',
    'A*02:30~B*13:02~DRB1*01:01', 'A*02:30~B*13:02~DRB1*01:02', 'A*02:30~B*13:02~DRB1*01:03' ]
RETURN abcqr.name, abcqr.frequency;


MATCH (abr:Haplotype)-[c1]-(abcr:Haplotype)-[c2]-(abcqr:Haplotype)
  WHERE abr.loci = 'ABR'
  AND abcr.loci = 'ABCR'
  AND abcqr.loci = 'ABCQR'
  AND abr.name IN [ 'A*02:01~B*13:02~DRB1*01:01', 'A*02:01~B*13:02~DRB1*01:02', 'A*02:01~B*13:02~DRB1*01:03',
    'A*02:02~B*13:02~DRB1*01:01', 'A*02:02~B*13:02~DRB1*01:02', 'A*02:02~B*13:02~DRB1*01:03',
    'A*02:05~B*13:02~DRB1*01:01', 'A*02:05~B*13:02~DRB1*01:02', 'A*02:05~B*13:02~DRB1*01:03',
    'A*02:06~B*13:02~DRB1*01:01', 'A*02:06~B*13:02~DRB1*01:02', 'A*02:06~B*13:02~DRB1*01:03',
    'A*02:13~B*13:02~DRB1*01:01', 'A*02:13~B*13:02~DRB1*01:02', 'A*02:13~B*13:02~DRB1*01:03',
    'A*02:17~B*13:02~DRB1*01:01', 'A*02:17~B*13:02~DRB1*01:02', 'A*02:17~B*13:02~DRB1*01:03',
    'A*02:19~B*13:02~DRB1*01:01', 'A*02:19~B*13:02~DRB1*01:02', 'A*02:19~B*13:02~DRB1*01:03',
    'A*02:20~B*13:02~DRB1*01:01', 'A*02:20~B*13:02~DRB1*01:02', 'A*02:20~B*13:02~DRB1*01:03',
    'A*02:24~B*13:02~DRB1*01:01', 'A*02:24~B*13:02~DRB1*01:02', 'A*02:24~B*13:02~DRB1*01:03',
    'A*02:30~B*13:02~DRB1*01:01', 'A*02:30~B*13:02~DRB1*01:02', 'A*02:30~B*13:02~DRB1*01:03' ]
RETURN abcqr.name, abcqr.frequency;